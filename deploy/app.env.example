# Copy to /etc/app/app.env on the server (via Ansible, not Git) and fill in
# real values, ideally pulled from AWS Secrets Manager / SSM Parameter
# Store rather than hard-coded. Never commit a real app.env file.

DB_HOST=your-rds-endpoint.example.rds.amazonaws.com
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=changeme
PORT=5000
